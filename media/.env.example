# The media server refuses to boot unless every one of these is set. That is
# deliberate: a voice agent with a missing key does not fail visibly, it answers
# the phone and then fails on the first turn, in front of a customer.
#
# Copy this file to media/.env and fill it in. Both the server and the harness
# read it on startup if it exists. Real environment variables win over the file,
# and in production there is no file at all, because Fly injects these as secrets.
#
# The offline harness (`make demo`) needs none of them. `make demo-live` needs
# only OPENROUTER_API_KEY.

# Hostname Twilio should open the media WebSocket back to.
PUBLIC_HOST=nightbell-media.fly.dev
PORT=8080

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Cartesia voice id. Pick one that stays intelligible at 8 kHz — a lot of voices
# that sound good in a browser demo turn to mush on a phone line.
CARTESIA_VOICE_ID=
# The conversational model, through OpenRouter. OPENROUTER_MODEL is optional and
# is the one setting here with a default: which model answers the phone is a
# question of price and time-to-first-token on the day, and the harness will run
# the whole scenario set against a candidate with --model=.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The Cloudflare control plane, and the shared secret used to talk to it.
CONTROL_PLANE_URL=https://nightbell-control.pages.dev
CONTROL_PLANE_TOKEN=

# Set to anything to print token counts, cached-prefix hits and the billed cost
# of every model call. A broken cache is silent: the call still works and the
# reply is still correct, it just costs several times more. Cached tokens should
# dominate after the first turn of a call.
# NIGHTBELL_CACHE_STATS=1
